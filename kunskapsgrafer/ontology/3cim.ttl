p3cim:absolutLagesosakerhet
  rdf:type owl:DatatypeProperty ;
  rdfs:range xsd:float ;
.
p3cim:absolutLagesosakerhetHojd
  rdf:type owl:DatatypeProperty ;
  rdfs:subPropertyOf p3cim:absolutLagesosakerhet ;
.
p3cim:absolutLagesosakerhetPlan
