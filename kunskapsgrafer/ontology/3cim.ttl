p3cim:TunnelBoundarySurface
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/tunnel/2.0/_BoundarySurface> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:tunnelMaterial ;
    ] ;
