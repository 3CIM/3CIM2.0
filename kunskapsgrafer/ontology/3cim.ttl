p3cim:TypAvLagesbestamningsmetod
  rdf:type owl:Class ;
  rdfs:subClassOf p3cim:Codelist ;
  owl:deprecated "true"^^xsd:boolean ;
  owl:oneOf (
      p3cim:TypAvLagesbestamningsmetod_GeodetiskDetaljmätning
      p3cim:TypAvLagesbestamningsmetod_Interpolering
      p3cim:TypAvLagesbestamningsmetod_Okänd
      p3cim:TypAvLagesbestamningsmetod_VektoriseringAvAnalogtMaterial
      p3cim:TypAvLagesbestamningsmetod_Konvertering
      p3cim:TypAvLagesbestamningsmetod_Lägesplacering
      p3cim:TypAvLagesbestamningsmetod_DetaljmätningILaserdata
      p3cim:TypAvLagesbestamningsmetod_FotogrammetriskDetaljmätning
    ) ;
.
