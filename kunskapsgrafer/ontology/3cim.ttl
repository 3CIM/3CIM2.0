# baseURI: http://digitalsamverkan.se/ont/3cim
# imports: http://cui.unige.ch/citygml/2.0/
# imports: http://schemas.opengis.net/geosparql/1.0/geosparql_vocab_all.rdf
# imports: http://www.w3.org/2006/time
# imports: https://www.opengis.net/ont/sf
# prefix: p3cim

@prefix : <http://digitalsamverkan.se/ont/3cim#> .
@prefix core: <http://www.opengis.net/citygml/2.0/> .
@prefix gml: <http://www.opengis.net/gml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p2.0: <http://cui.unige.ch/citygml/2.0/> .
@prefix p3cim: <http://digitalsamverkan.se/ont/3cim#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://digitalsamverkan.se/ont/3cim>
  rdf:type owl:Ontology ;
  rdfs:comment "OWL representation based on the information model developed by the 3CIM-project"@en ;
  rdfs:comment "OWL-representation av 3CIM-projektets informationsmodell"@sv ;
  rdfs:label "3CIM Ontology"@en ;
  rdfs:label "3CIM-ontologi"@sv ;
  rdfs:seeAlso <https://www.smartbuilt.se/projekt/informationsinfrastruktur/3cim/> ;
  owl:imports p2.0: ;
  owl:imports <http://schemas.opengis.net/geosparql/1.0/geosparql_vocab_all.rdf> ;
  owl:imports <http://www.w3.org/2006/time> ;
  owl:imports <https://www.opengis.net/ont/sf> ;
  owl:priorVersion <http://digitalsamverkan.se/ont/3cim/1.0> ;
  owl:versionIRI <http://digitalsamverkan.se/ont/3cim/2.0> ;
  owl:versionInfo "2.0" ;
.
p3cim:AnledningTillOsakertLage
  rdf:type owl:Class ;
  rdfs:subClassOf p3cim:Codelist ;
  owl:deprecated "true"^^xsd:boolean ;
  owl:oneOf (
      p3cim:AnledningTillOsakertLage_LägesplaceringIUngefärligtLäge
      p3cim:AnledningTillOsakertLage_SkymtLägeVidInmätning
      p3cim:AnledningTillOsakertLage_LägesplaceringIIllustrativtLäge
    ) ;
.
p3cim:AnledningTillOsakertLage_LägesplaceringIIllustrativtLäge
  rdf:type p3cim:AnledningTillOsakertLage ;
  rdfs:label "Lägesplacering i illustrativt läge"@sv ;
.
p3cim:AnledningTillOsakertLage_LägesplaceringIUngefärligtLäge
  rdf:type p3cim:AnledningTillOsakertLage ;
  rdfs:label "Lägesplacering i ungefärligt läge"@sv ;
.
p3cim:AnledningTillOsakertLage_SkymtLägeVidInmätning
  rdf:type p3cim:AnledningTillOsakertLage ;
  rdfs:label "Skymt läge vid inmätning"@sv ;
.
p3cim:Bridge
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/bridge/2.0/Bridge> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:bridgeTransportUUID ;
    ] ;
.
p3cim:BuildingInstallation
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/building/2.0/BuildingInstallation> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:connectsToGround ;
    ] ;
.
p3cim:BuildingPart
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/building/2.0/BuildingPart> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:architecturalStyle ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:facadeAppearanceColor ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:facadeAppearanceMaterial ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:facadeBaseAppearanceColor ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:facadeBaseAppearanceMaterial ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:parametricModuleSequenceType ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:roofAppearanceColor ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:roofAppearanceMaterial ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:windowFrameAppearanceColor ;
    ] ;
.
p3cim:CityFurniture
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/cityfurniture/2.0/CityFurniture> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:cityFurnitureRelativeHeight ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:cityFurnitureWidth ;
    ] ;
.
p3cim:CoClass
  rdf:type owl:Class ;
  rdfs:subClassOf p3cim:ThreeCIMRoot ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:coClassId ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:coClassVersion ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:coClassKod ;
    ] ;
.
p3cim:Codelist
  rdf:type owl:Class ;
  rdfs:subClassOf p3cim:ThreeCIMRoot ;
.
p3cim:Diameter
  rdf:type owl:DatatypeProperty ;
  rdfs:range xsd:float ;
  rdfs:subPropertyOf p3cim:MeasureValue ;
.
p3cim:GeometryMetadata
  rdf:type owl:Class ;
  rdfs:subClassOf p3cim:ThreeCIMRoot ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:absolutLagesosakerhetHojd ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:absolutLagesosakerhetPlan ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:lagesbestamningsmetodIHojd ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:lagesbestamningsmetodIPlan ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:osakertLage ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:tidpunktForKontrollAvGeometri ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:tidpunktForLagesbestamning ;
    ] ;
  owl:deprecated "true"^^xsd:boolean ;
.
p3cim:Height
  rdf:type owl:DatatypeProperty ;
  rdfs:range xsd:float ;
  rdfs:subPropertyOf p3cim:MeasureValue ;
.
p3cim:InteriorWallSurface
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/tunnel/2.0/InteriorWallSurface> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:tunnelShape ;
    ] ;
.
p3cim:Intersection
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/transportation/2.0/TransportationComplex> ;
.
p3cim:Lagesbestamningsmetod
  rdf:type owl:Class ;
  rdfs:subClassOf p3cim:ThreeCIMRoot ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:tidsperiodForUnderlagetsFramtagande ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onClass p3cim:TypAvLagesbestamningsmetod ;
      owl:onProperty p3cim:typ ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    ] ;
  owl:deprecated "true"^^xsd:boolean ;
.
p3cim:LandCover
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/landuse/2.0/LandUse> ;
.
p3cim:LandCoverClosureSurface
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/landuse/2.0/LandUse> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:ursprungsObjektUUID ;
    ] ;
.
p3cim:Marking
  rdf:type owl:Class ;
  rdfs:subClassOf p3cim:ThreeCIMRoot ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:markingType ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:lod2MultiCurve ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:lod2Point ;
    ] ;
.
p3cim:MeasureValue
  rdf:type owl:DatatypeProperty ;
.
p3cim:PlantCover
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/vegetation/2.0/PlantCover> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:plantCoverSpeciesPopularName ;
    ] ;
.
p3cim:Railway
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/transportation/2.0/Railway> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:trackGauge ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:intersectionOfRailway ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:sectionOfRailway ;
    ] ;
.
p3cim:Road
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/transportation/2.0/Road> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:intersectionOfRoad ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:sectionOfRoad ;
    ] ;
.
p3cim:Section
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/transportation/2.0/TransportationComplex> ;
.
p3cim:SolitaryVegetationObject
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/vegetation/2.0/SolitaryVegetationObject> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:solitaryVegetationSpeciesPopularName ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:lowerCrownHeight ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:solitaryVegetationWidth ;
    ] ;
.
p3cim:ThreeCIMRoot
  rdf:type owl:Class ;
  rdfs:subClassOf owl:Thing ;
.
p3cim:Track
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/transportation/2.0/Track> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:intersectionOfTrack ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:sectionOfTrack ;
    ] ;
