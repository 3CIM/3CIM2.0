p3cim:UUID
  rdf:type owl:DatatypeProperty ;
  rdfs:range xsd:string ;
.
p3cim:Utility
  rdf:type owl:Class ;
  rdfs:subClassOf core:_CityObject ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:class ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:utilityDiameter ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty <http://www.opengis.net/citygml/generics/2.0/lod1ImplicitRepresentation> ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty p3cim:function ;
    ] ;
.
p3cim:WaterBody
  rdf:type owl:Class ;
  rdfs:subClassOf <http://www.opengis.net/citygml/waterbody/2.0/WaterBody> ;
